# Copy to deploy/.env.production. Never commit this file after filling secrets.
DOMAIN=proxy.example.com
GATEWAY_HOST=proxy.example.com
GATEWAY_EXTERNAL_PORT=3128
JWT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
PROXY_CREDENTIAL_SECRET=REPLACE_WITH_ANOTHER_64_RANDOM_HEX_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MAIL_MODE=smtp
REGISTER_REQUIRE_CODE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS=
SMTP_FROM="ResiHub <no-reply@example.com>"
PAYMENT_MODE=real
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=/run/secrets/alipay-private.pem
ALIPAY_PUBLIC_KEY=/run/secrets/alipay-public.pem
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
WEPAY_MCHID=
WEPAY_APPID=
WEPAY_SERIAL=
WEPAY_PRIVATE_KEY=/run/secrets/wechat-private.pem
WEPAY_APIV3_KEY=
WEPAY_PLATFORM_PUBLIC_KEY=/run/secrets/wechat-platform-public.pem
# Platform public key ID (PUB_KEY_ID_...) or the matching platform certificate serial.
WEPAY_PLATFORM_SERIAL=
GATEWAY_ALLOW_PRIVATE_TARGETS=false
GATEWAY_MAX_CONNECTIONS=20
# Express sees one Caddy reverse proxy, never trust arbitrary X-Forwarded-For headers.
TRUST_PROXY=1
