# ============ ResiHub 服务端环境变量 ============
# 复制为 .env 后修改。生产环境务必修改 JWT_SECRET 与管理员密码。

# ---- 基础 ----
PORT=8080
GATEWAY_PORT=3128
# 对外访问的站点基址（用于拼接支付回调/跳转、模拟收银台链接）
PUBLIC_BASE_URL=http://localhost:8080
# 展示给用户的网关地址（仅展示用，一般是服务器公网 IP 或域名）
PUBLIC_GATEWAY_HOST=127.0.0.1
GATEWAY_ALLOW_PRIVATE_TARGETS=false
GATEWAY_MAX_CONNECTIONS=20
TRUST_PROXY=0
# JWT 密钥：生产环境必须替换为长随机串
JWT_SECRET=change-me-to-a-long-random-string
# 静态代理凭据加密密钥。独立稳定保存，变更 JWT 时请勿同步轮换此值。
PROXY_CREDENTIAL_SECRET=
# SQLite 数据库文件路径
DB_PATH=./data/resihub.db

# ---- 邮件验证码: mock | smtp ----
# mock: 验证码不真正发送，打印到服务端日志，并随接口返回 dev_code（仅开发用）
MAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ResiHub <no-reply@example.com>"
# 注册是否必须邮箱验证码（开启 SMTP 后建议 true）
REGISTER_REQUIRE_CODE=false

# ---- 支付: mock | real ----
# mock: 生成站内模拟收银台（/mock/pay/:no），可手动点“支付成功”走完整回调逻辑
# real: 使用真实支付宝/微信商户配置
PAYMENT_MODE=mock
# 支付完成后的前端跳转地址
PAY_RETURN_BASE_URL=http://localhost:5173

# 支付宝（电脑网站支付/当面付，RSA2）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
# 沙箱网关: https://openapi-sandbox.dl.alipaydev.com/gateway.do  正式: https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# 微信支付 V3（Native 扫码支付）
WEPAY_MCHID=
WEPAY_APPID=
WEPAY_SERIAL=
# 商户 API 私钥：PEM 文件路径，或直接填 PEM 内容（以 -----BEGIN 开头）
WEPAY_PRIVATE_KEY=
WEPAY_APIV3_KEY=
# 微信支付平台公钥或平台证书 PEM 文件；不能使用商户自己的证书
WEPAY_PLATFORM_PUBLIC_KEY=
# 对应的平台公钥 ID (PUB_KEY_ID_...) 或平台证书序列号
WEPAY_PLATFORM_SERIAL=

# 生产首次启动必须设置，开发模式才允许内置测试账号
ADMIN_EMAIL=
ADMIN_PASSWORD=
